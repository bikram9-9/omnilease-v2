{
  "name": "omnilease",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "ci:verify": "turbo run lint --force && turbo run build --force && turbo run typecheck --force && turbo run test:unit --force && turbo run test:integration --force",
    "dev": "turbo run dev",
    "e2e:smoke": "./scripts/e2e-playwright-flows.sh",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:evals": "pnpm --filter @omnilease/web test:evals",
    "test:integration": "turbo run test:integration",
    "test:unit": "turbo run test:unit",
    "typecheck": "turbo run typecheck",
    "web:dev": "pnpm --filter @omnilease/web dev",
    "db:generate": "pnpm --filter @omnilease/db db:generate",
    "db:migrate": "pnpm --filter @omnilease/db db:migrate",
    "db:studio": "pnpm --filter @omnilease/db db:studio"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.6.0"
  },
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  }
}
