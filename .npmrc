# React Native and Expo packages must be hoisted to the workspace root so
# Metro (which doesn't natively understand pnpm's symlink layout) can resolve
# them. Without this, `apps/mobile` fails with "Unable to resolve module
# react-native" or duplicate-React errors.
#
# We hoist only RN/Expo-related packages, not everything, so the web app's
# strict isolation stays intact.
public-hoist-pattern[]=*react-native*
public-hoist-pattern[]=*expo*
public-hoist-pattern[]=@react-native*
public-hoist-pattern[]=@expo*
public-hoist-pattern[]=metro*
public-hoist-pattern[]=react-refresh
public-hoist-pattern[]=scheduler
