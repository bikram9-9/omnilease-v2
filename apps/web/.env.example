# Database (Supabase Postgres)
#
# If you see: getaddrinfo ENOTFOUND db.<project>.supabase.co
# - The "Direct connection" host is often IPv6-only. Many local networks don't have IPv6.
# - Fix: Supabase Dashboard -> Project Settings -> Database -> Connection string
#   -> "Session pooler" (port 5432) for long-lived app servers, or "Transaction" (6543) for serverless.
#   The Supabase CLI `supabase db dump --linked --dry-run` prints PGHOST/PGPORT/PGUSER to match.
# - Do not hand-edit: paste the full URI from the dashboard, or you will get ENOTFOUND / auth errors.
#
DATABASE_URL=postgresql://postgres.REPLACE_PROJECT_REF:REPLACE_PASSWORD@aws-0-REPLACE_REGION.pooler.supabase.com:5432/postgres

# Supabase Auth (public — used by client + server SDK)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# NEXT_PUBLIC_SUPABASE_ANON_KEY is also accepted by the app if your Supabase
# project still uses anon-key naming.

# ---- AI Gateway (OIDC-authenticated Claude via model strings) ----
# No env var to set. Run `vercel link` → enable AI Gateway in the Vercel
# dashboard → `vercel env pull`. This provisions VERCEL_OIDC_TOKEN automatically
# and rotates it on each deploy. Zero manual key management. OIDC is the only
# supported auth method for this project.
OMNILEASE_AI_MODEL=anthropic/claude-sonnet-4.6

# ---- Resend (escalation email) ----
# Production/default email delivery path.
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=Omnilease <info@omnilease.ai>
EMAIL_FROM=Omnilease <info@omnilease.ai>

# ---- Hosted cron ----
# Required in production. Vercel cron calls GET /api/cron/tour-notifications.
TOUR_NOTIFICATION_CRON_SECRET=replace-with-random-secret

# ---- Local SMTP / Mailpit (optional, takes precedence over Resend when set) ----
# For local development with Mailpit:
#   docker run -d --name mailpit -p 1025:1025 -p 8025:8025 axllent/mailpit
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false

# For local smoke tests only. Do not set this in production.
# EMAIL_DELIVERY_MODE=log

# Property context lives in Markdown at:
#   content/properties/<property-slug>/{overview,amenities,policies,faqs,touring}.md

# Public URL of this app — currently used by the escalation email template.
APP_URL=http://localhost:3000
