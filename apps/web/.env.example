# Database (Supabase Postgres)
#
# If you see: getaddrinfo ENOTFOUND db.<project>.supabase.co
# - The "Direct connection" host is often IPv6-only. Many local networks don't have IPv6.
# - Fix: Supabase Dashboard -> Project Settings -> Database -> Connection string
#   -> choose "Session pooler" (or "Transaction" for serverless) and copy the full URI.
# - Do not hand-edit the hostname; paste exactly from the dashboard.
#
DATABASE_URL=postgresql://postgres.REPLACE_PROJECT_REF:REPLACE_PASSWORD@aws-0-REPLACE_REGION.pooler.supabase.com:6543/postgres

# Supabase Auth (public — used by client + server SDK)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx